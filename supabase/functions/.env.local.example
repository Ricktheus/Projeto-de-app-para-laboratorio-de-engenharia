# Local secrets for `supabase functions serve` (NEVER commit the real values).
# In production set these with `supabase secrets set KEY=value`.
OPENAI_API_KEY=sk-your-openai-key
# S008 — gerar-laudo-pdf:
# Anti-fraud hash secret: codigo_verificacao = sha256(laudo_id + secret) (SPEC §7.1).
LAUDO_VERIFICATION_SECRET=change-me-to-a-long-random-secret
# Public base URL embedded in the validation QR (<site>/validar/<codigo>) and in
# the portal link of client e-mails (<site>/portal). Used by gerar-laudo-pdf and
# enviar-email.
PUBLIC_SITE_URL=https://laboratorio.example.com
# S009 — enviar-email (transactional e-mail via Resend):
# Resend API key (transactional e-mail). Only in the function environment.
RESEND_API_KEY=re_your_resend_key
# From address used by Resend (must be a verified sender/domain in Resend).
EMAIL_FROM=Laboratório de Concreto <no-reply@laboratorio.example.com>
# Shared secret for server-to-server / cron invocation of enviar-email
# (header `x-cron-secret`). Admin JWTs are also accepted.
EMAIL_CRON_SECRET=change-me-to-a-long-random-secret
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the Supabase runtime; only override them for a custom local setup.
