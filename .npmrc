# Expo / React Native's Metro bundler cannot traverse pnpm's nested, symlinked
# node_modules: it only resolves packages found directly under a project's (or
# the workspace root's) node_modules. Hoisting every dependency to the root
# node_modules makes transitive deps (e.g. @babel/runtime,
# react-native-css-interop) resolvable by Metro while keeping the pnpm store.
# See: https://docs.expo.dev/guides/monorepos/#pnpm
shamefully-hoist=true
